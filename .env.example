NODE_ENV=development
PORT=3000

# Database Connection (PostgreSQL via Docker or Native)
DATABASE_URL=postgresql://app_user:local_password@localhost:5432/project_management?schema=public

# Docker compose database credentials
DB_USER=app_user
DB_PASSWORD=local_password
DB_NAME=project_management
DB_PORT=5432

# Authentication & JWT Configuration
JWT_ACCESS_SECRET=replace_with_a_strong_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_strong_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=project-management-api
JWT_AUDIENCE=project-management-clients

# CORS & Security
WEB_ORIGIN=http://localhost:5173

# Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=30
