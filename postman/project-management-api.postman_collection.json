      "name": "5. Two-User Security Isolation Tests",
      "item": [
        {
          "name": "Test 1: User B reads User A Project (Expects 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Cross-user project read returns 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
